# Copiar como .env en la raíz del repositorio y ajustar los valores.
# Servidor de MLflow en EC2 donde se registran los experimentos de los cuadernos
MLFLOW_TRACKING_URI=http://<ip-ec2-mlflow>:8050
# Enlace del botón "Ver experimentos en MLflow" del tablero (docker compose lo lee)
MLFLOW_UI_URL=http://<ip-ec2-mlflow>:8050
# Mínimo de anuncios para habilitar una localidad (cuaderno 01)
MIN_ANUNCIOS_LOCALIDAD=500
